# Copy to .env and fill in. Never commit .env, and never read these values
# from browser JavaScript.
APP_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_app
DB_USER=portfolio_app
DB_PASSWORD=replace_with_a_strong_password

# Days a signed-in session stays valid.
SESSION_LIFETIME_DAYS=14

# Failed sign-ins allowed per email and per IP before a temporary lockout,
# and the window they are counted over.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
